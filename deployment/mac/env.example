# ~/.config/keenroudy/env on the Mac: KEY=value lines, read by run.sh (never sourced, never committed).
# This file lists the names and what each is for. The real values live only in that file; never put them in the repo,
# a log, a prompt or a chat.

# Where the desk's own clone lives (it pulls, commits and pushes there). Default: /Users/keen/Projects/sports
KEENROUDY_REPO=

# The Odds API (free tier, 500 credits a month): spreads and totals across books, the NFL easy parlay's alternate lines.
# Also a GitHub Actions secret of the same name for the hosted workflow.
ODDS_API_KEY=

# SharpAPI (free tier): DraftKings and FanDuel player prop prices and alternate lines, both leagues.
# Also a GitHub Actions secret of the same name.
SHARP_API=

# The local model the desk uses to polish prose and weigh news (Ollama on this Mac). Default: qwen3:32b
KEENROUDY_LLM_MODEL=
# The faster local model for guarded rewrites and summaries. Judgment never falls through to it. Default: qwen3:8b
KEENROUDY_LLM_FAST_MODEL=

# The web researcher (scripts/researcher.py): codex (OpenAI Codex CLI, signed in with the ChatGPT plan),
# or empty to turn it off. Unknown and retired engine names stay off; they never fall back to another provider.
KEENROUDY_RESEARCHER=
# Pin routine live fact extraction to an efficient model/effort instead of the Codex CLI's interactive default.
KEENROUDY_RESEARCHER_MODEL=
KEENROUDY_RESEARCHER_REASONING=
# The weekly code-aware review needs more judgment than extraction, but not the interactive default's high effort.
KEENROUDY_REVIEW_MODEL=
KEENROUDY_REVIEW_REASONING=

# Buffer (free plan) posts to X for the desk: a personal API key and the X channel id.
BUFFER_TOKEN=
BUFFER_CHANNEL=

# Discord: incoming webhook for #todays-plays. The desk mirrors a post only after Buffer confirms it went live on X.
DISCORD_WEBHOOK_URL=

# ntfy (free): the private topic the owner's phone subscribes to for alerts ("run stopped", "pin it").
KEENROUDY_NTFY_TOPIC=
# Private arb radar. Blank books means every captured book; comma-separated keys can limit alerts to accounts you use.
# Current keys: draftkings,fanduel,betmgm,caesars,betrivers,espnbet,fanatics,hardrockbet
KEENROUDY_ARB_BOOKS=
KEENROUDY_ARB_MIN_ROI=1.0

# Posting through X's own API (unused since Buffer; leave empty).
KEENROUDY_X_AUTONOMOUS=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
