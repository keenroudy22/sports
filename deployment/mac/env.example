# ~/.config/keenroudy/env on the Mac: KEY=value lines, read by run.sh (never sourced, never committed).
# This file lists the names and what each is for. The real values live only in that file; never put them in the repo,
# a log, a prompt or a chat.

# Where the desk's own clone lives (it pulls, commits and pushes there). Default: /Users/keen/Projects/sports
KEENROUDY_REPO=

# The Odds API (free tier, 500 credits a month): spreads and totals across books, the NFL easy parlay's alternate lines.
# Also a GitHub Actions secret of the same name for the hosted workflow.
ODDS_API_KEY=

# SharpAPI (free tier): DraftKings and FanDuel player prop prices and alternate lines, both leagues.
# Also a GitHub Actions secret of the same name.
SHARP_API=

# The local model that weighs already verified facts (Ollama on this Mac). Default: qwen3.8:27b
# Local homepage research selection runs after social scheduling. Set 0 to disable; no cloud fallback.
# KEENROUDY_LOCAL_EDITOR=1
# Retain the loaded sports model between checks; Ollama may evict it. Set 15m for the former memory-saving behavior.
# KEENROUDY_LLM_KEEP_ALIVE=12h
KEENROUDY_LLM_MODEL=
# Optional model for guarded rewrites. Judgment never falls through to it. Default: qwen3.5:9b-mlx
KEENROUDY_LLM_FAST_MODEL=
# Rewriting is off by default because the deterministic templates are complete. Set 1 only for a measured experiment.
KEENROUDY_LLM_POLISH=
KEENROUDY_LIVE_SHADOW=             # set 0 only to disable silent live-game observation
KEENROUDY_LIVE_PROGRESS=pilot      # bounded 3-message Discord trial; 0 disables; never enables X

# The web researcher (scripts/researcher.py): codex (OpenAI Codex CLI, signed in with the ChatGPT plan),
# or empty to turn it off. Unknown and retired engine names stay off; they never fall back to another provider.
KEENROUDY_RESEARCHER=
# Pin routine live fact extraction to an efficient model/effort instead of the Codex CLI's interactive default.
KEENROUDY_RESEARCHER_MODEL=
KEENROUDY_RESEARCHER_REASONING=
# Used only by review.py --codex. The scheduled weekly brief defaults to the local model, not cloud.
KEENROUDY_REVIEW_MODEL=
KEENROUDY_REVIEW_REASONING=

# Buffer (free plan) posts to X for the desk: a personal API key and the X channel id.
BUFFER_TOKEN=
BUFFER_CHANNEL=

# Discord: incoming webhook for #todays-plays. Confirmed plays arrive before X; other approved posts mirror after X.
DISCORD_WEBHOOK_URL=
# Optional dedicated #arb-radar webhook. When blank, qualifying alerts use DISCORD_WEBHOOK_URL instead.
DISCORD_ARB_WEBHOOK_URL=

# ntfy (free): the private topic the owner's phone subscribes to for alerts ("run stopped", "pin it").
KEENROUDY_NTFY_TOPIC=
# Discord-only arb radar. Blank books means every captured book; comma-separated keys can limit alerts to accounts you use.
# Current keys: draftkings,fanduel,betmgm,caesars,betrivers,espnbet,fanatics,hardrockbet
KEENROUDY_ARB_BOOKS=
KEENROUDY_ARB_MIN_ROI=1.0

# SportsGameOdds Amateur/free plan shadow evaluation. The desk checks /account/usage before every sample, runs only
# when that endpoint confirms a 2,500-object ceiling, and stops at 1,800. It never alerts or changes a public play.
SPORTSGAMEODDS_API_KEY=

# Posting through X's own API (unused since Buffer; leave empty).
KEENROUDY_X_AUTONOMOUS=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
