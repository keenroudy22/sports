<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  KeenRoudy Sports research desk: the scheduled runs from PROMPT.md, Eastern time.
  Separate from every com.mygolflinks.* job. The wrapper sets PATH, TZ, GH_CONFIG_DIR and the
  secrets; run.py maps the clock to the slot, so a stray fire is harmless.

  Live since 2026-09-23, one kind at a time: "--publish-kinds settle,close" first, then
  "settle,close,lean,prop,longshot", then everything (drop the flag). After editing, reload with
    launchctl bootout gui/$(id -u)/com.keenroudy.sports.run
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.keenroudy.sports.run.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.keenroudy.sports.run</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/keen/.config/keenroudy/run.sh</string>
    <string>run</string>
    <string>--publish-kinds</string>
    <string>settle,close,lean,prop,longshot</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>America/New_York</string>
  </dict>

  <!-- launchd reads these in the machine's local time, which is Eastern on this Mac; the
       heartbeat checks that it stays so. Weekday 0 is Sunday. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>50</integer><key>Weekday</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>50</integer><key>Weekday</key><integer>1</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>50</integer><key>Weekday</key><integer>4</integer></dict>
    <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Users/keen/Library/Logs/KeenRoudy/launchd.run.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/keen/Library/Logs/KeenRoudy/launchd.run.log</string>
</dict>
</plist>
